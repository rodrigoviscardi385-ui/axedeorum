<section class="section carrinho">
  <div class="container">
    <h2>Carrinho de Compras</h2>
    
    <% if (!cartItems.length) { %>
      <p>Seu carrinho está vazio. <a href="/">Voltar ao site</a></p>
    <% } else { %>
      <table class="cart-table">
        <thead>
          <tr>
            <th>Produto</th>
            <th>Preço</th>
            <th>Qtde</th>
            <th>Subtotal</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% cartItems.forEach(item => { %>
            <tr>
              <td>
                <img src="/images/pendentes/<%= item.product.image %>" alt="<%= item.product.name %>" width="50">
                <span><%= item.product.name %></span>
              </td>
              <td>R$ <%= item.product.price %></td>
              <td>
                <input type="number" min="1" value="<%= item.quantity %>" data-id="<%= item.id %>">
              </td>
              <td>R$ <%= (item.product.price * item.quantity).toFixed(2) %></td>
              <td><a href="/cart/remover/<%= item.id %>" class="remover">Remover</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      
      <div class="cart-total">
        <span>Total:</span>
        <strong>R$ <%= total.toFixed(2) %></strong>
      </div>
      
      <a href="/checkout" class="btn btn-gold btn-wide">Proceed to Checkout</a>
      <a href="/" class="btn btn-outline btn-wide">Continuar comprando</a>
    <% } %>
  </div>
</section>