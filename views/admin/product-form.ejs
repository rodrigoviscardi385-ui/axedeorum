<section class="section admin">
  <div class="container">
    <h2><%= product ? 'Editar Produto' : 'Novo Produto' %></h2>
    
    <form action="<%= action %>" method="POST" enctype="multipart/form-data">
      <input type="hidden" name="id" value="<%= product ? product.id : '' %>">
      
      <div class="form-group">
        <label>Nome do Produto</label>
        <input type="text" name="name" value="<%= product ? product.name : '' %>" required>
      </div>
      
      <div class="form-group">
        <label>Descrição</label>
        <textarea name="description" rows="3"><%= product ? product.description : '' %></textarea>
      </div>
      
      <div class="form-group">
        <label>Preço (R$)</label>
        <input type="number" step="0.01" name="price" value="<%= product ? product.price : '' %>" required>
      </div>
      
      <div class="form-group">
        <label>Categoria</label>
        <select name="category">
          <option value="pendente" <%= product && product.category === 'pendente' ? 'selected' : '' %>>Pingente</option>
          <option value="firma" <%= product && product.category === 'firma' ? 'selected' : '' %>>Firma</option>
        </select>
      </div>
      
      <div class="form-group">
        <label>Imagem (URL)</label>
        <input type="text" name="image" value="<%= product ? product.image : '' %>" placeholder="URL da imagem">
      </div>
      
      <button type="submit" class="btn btn-gold"><%= product ? 'Atualizar' : 'Criar' %></button>
      <a href="/admin/products" class="btn btn-outline">Cancelar</a>
    </form>
  </div>
</section>