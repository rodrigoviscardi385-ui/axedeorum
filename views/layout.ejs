<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="description" content="Axé de Orum - Guias artesanais de Umbanda e Candomblé">
  
  <!-- Meta tags SEO -->
  <meta property="og:title" content="Axé de Orum - Guias Artesanais">
  <meta property="og:description" content="Crie sua própria guia de proteção: cores, firmas, pingentes e ferramentas das Sete Linhas">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://axedeorum.com">
  <meta property="og:image" content="/images/og-image.png">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Axé de Orum - Guias Artesanais">
  <meta name="twitter:description" content="Crie sua própria guia de proteção">
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=EB+Merriweather:ital,wght@0,400;0,700;1,400;1,700&family=Merriweather:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&display=swap" rel="stylesheet">
  
  <!-- Styles -->
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/builder.css">
  
  <!-- Favicon -->
  <link rel="icon" href="/favicon.svg">
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="brand" aria-label="Axé de Orum - início">
        <span class="brand-star" aria-hidden="true"></span>
        <span class="brand-text">
          <span class="brand-name">Axé de Orum</span>
          <span class="brand-tag">@axedeorum</span>
        </span>
      </a>
      <nav class="site-nav" id="site-nav" aria-label="Navegação principal">
        <a href="#linhas">Sete Linhas</a>
        <a href="#criar">Criar Guia</a>
        <a href="#precos">Preços</a>
        <a href="#pingentes">Pingentes</a>
        <a href="#firmas">Firmas</a>
        <a href="#processo">Processo</a>
        <a href="#contato">Contato</a>
        <% if (isLoggedIn) { %>
          <a href="/auth/logout">Sair</a>
        <% } else { %>
          <a href="/auth/login">Login</a>
          <a href="/auth/register">Cadastro</a>
        <% } %>
      </nav>
      <button class="nav-toggle" id="nav-toggle" aria-label="Abrir menu" aria-expanded="false" aria-controls="site-nav">
        <span></span><span></span><span></span>
      </button>
    </div>
  </header>

  <main>
    <%= body %>
  </main>

  <footer class="contato" id="contato">
    <div class="container">
      <div class="contato-inner">
        <div class="contato-info">
          <h2>Axé de Orum</h2>
          <p class="contato-tag">Guias Artesanais de Umbanda e Candomblé</p>
          <p>Crie a sua guia ou peça uma orientação personalizada. Atendemos com carinho, respeito e axé.</p>
          <div class="contato-actions">
            <a class="btn btn-gold" href="https://wa.me/5513997781447" target="_blank" rel="noopener">WhatsApp (13) 99778-1447</a>
            <a class="btn btn-ghost" href="https://www.instagram.com/axedeorum" target="_blank" rel="noopener">Instagram @axedeorum</a>
          </div>
        </div>
        <div class="contato-firma" aria-hidden="true">
          <svg viewBox="0 0 64 64" width="120" height="120">
            <circle cx="32" cy="32" r="30" fill="none" stroke="#C9A227" stroke-width="1.5"/>
            <circle cx="32" cy="32" r="24" fill="none" stroke="#C9A227" stroke-width="0.8"/>
            <path d="M32 12l5 13h14l-11 9 4 15-12-8-12 8 4-15-11-9h14z" fill="#C9A227"/>
          </svg>
        </div>
      </div>
      <div class="footer-rule"></div>
      <div class="footer-base">
        <p>© <span id="year"></span> Axé de Orum — @axedeorum</p>
        <p class="footer-respeito">Peças artesanais e consagradas, no respeito às tradições de matriz africana.</p>
      </div>
    </div>
  </footer>

  <!-- Scripts -->
  <script src="/app.js"></script>
</body>
</html>