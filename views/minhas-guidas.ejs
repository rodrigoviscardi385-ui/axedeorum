<section class="section auth">
  <div class="container">
    <div class="auth-card">
      <h2>Minhas Guias</h2>
      <ul class="guidas-list">
        <% guides.forEach(guide => { %>
          <li>
            <a href="/builder/guia/<%= guide.id %>" class="guida-item">
              <span class="guida-rixa"><%= guide.orixa || 'Sem Orixá' %></span>
              <span class="guida-data">Criada em <%= guide.created_at ? guide.created_at.split(' ')[0] : '—' %></span>
            </a>
          </li>
        <% }) %>
      </ul>
      <% if (!guides.length) { %>
        <p>Você ainda não tem guias salvas. <a href="/builder/criar">Crie sua primeira guia</a>.</p>
      <% } %>
    </div>
  </div>
</section>